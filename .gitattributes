# Auto detect text files and perform LF normalization
* text=auto

# Les scripts Windows doivent garder des fins de ligne CRLF (sinon cmd peut mal lire les « goto »)
*.bat text eol=crlf

# Scripts macOS : fins de ligne LF (sinon bash échoue sur « \r »)
*.sh text eol=lf
*.command text eol=lf

# Icône macOS
*.icns binary
